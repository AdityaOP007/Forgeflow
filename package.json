{
  "name": "forgeflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "dev": "pnpm db:migrate && pnpm db:seed && pnpm --filter @forgeflow/api --filter @forgeflow/web --parallel dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @forgeflow/api db:generate",
    "db:migrate": "pnpm --filter @forgeflow/api db:migrate",
    "db:seed": "pnpm --filter @forgeflow/api db:seed",
    "db:studio": "pnpm --filter @forgeflow/api db:studio",
    "db:reset": "pnpm --filter @forgeflow/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0"
  }
}
