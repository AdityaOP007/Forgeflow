PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://forgeflow:forgeflow_password@localhost:5432/forgeflow
TEST_DATABASE_URL=postgresql://forgeflow:forgeflow_password@localhost:5432/forgeflow_test
LOCAL_USER_EMAIL=admin@forgeflow.local
WORKER_POLL_MS=1000
WORKER_STALE_MS=120000

# GitHub App Integration (optional; omit to leave GitHub integration unconfigured)
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_ORG=your-github-org
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=

# CI Sync & Kubernetes Worker (optional)
CI_SYNC_INTERVAL_MS=60000
RECONCILE_INTERVAL_MS=30000
DEPLOY_TIMEOUT_SECONDS=600
KUBECONFIG_WORKER_PATH=./secrets/worker-kubeconfig.yaml
K8S_NAMESPACE=forgeflow-dev
CHART_PATH=infrastructure/helm/service-chart

# GHCR Image Pull Credentials (optional at startup; used by worker for Kubernetes imagePullSecret)
GHCR_PULL_USERNAME=your-github-username
GHCR_PULL_TOKEN=ghp_your_read_packages_token
