PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://forgeflow:forgeflow_password@localhost:5432/forgeflow
TEST_DATABASE_URL=postgresql://forgeflow:forgeflow_password@localhost:5432/forgeflow_test
LOCAL_USER_EMAIL=admin@forgeflow.local
WORKER_POLL_MS=1000
WORKER_STALE_MS=120000

# GitHub App Integration (optional; omit to leave GitHub integration unconfigured)
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_ORG=your-github-org
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
